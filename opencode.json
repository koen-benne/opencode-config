{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "./plugins/bonzai-project-key-switcher",
    "./plugins/bonzai-model-catalog"
  ],
  "autoupdate": false,
  "lsp": {
    "nil": {
      "command": [
        "nil"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "model": "bedrock/claude-sonnet-5",
  "small_model": "bonzai-openai/gpt-4.1-mini",
  "provider": {
    "bonzai-universal": {
      "name": "Bonzai Universal",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://connect.iobonzai.com",
        "litellmProxy": true
      },
      "activation": "enabled"
    },
    "bonzai-openai": {
      "name": "Bonzai OpenAI",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://connect.iobonzai.com/v1",
        "litellmProxy": true
      },
      "activation": "enabled",
      "models": {
        "gpt-4.1-mini": {
          "name": "GPT-4.1 Mini"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol"
        }
      }
    },
    "bedrock": {
      "name": "Bonzai Bedrock",
      "npm": "@ai-sdk/amazon-bedrock",
      "options": {
        "region": "eu-central-1",
        "baseURL": "https://connect.iobonzai.com/bedrock",
        "headers": {
          "anthropic-beta": "claude-code-20250219,interleaved-thinking-2025-05-14,fine-grained-tool-streaming-2025-05-14"
        },
        "litellmProxy": true
      },
      "activation": "enabled",
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        }
      }
    },
    "bonzai-vertex": {
      "name": "Bonzai Vertex",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://connect.iobonzai.com/v1"
      },
      "activation": "enabled"
    }
  },
  "default_agent": "build"
}
